{
  "$schema": "apps/server/node_modules/wrangler/config-schema.json",
  // 放在仓库根目录：Deploy to Cloudflare 按钮从仓库根目录读取 Wrangler 配置，并按这里的绑定创建 D1 与 R2。
  "name": "novarium",
  "main": "apps/server/src/worker.ts",
  "compatibility_date": "2026-11-24",
  "secrets": {
    "required": ["OWNER_PASSWORD"]
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novarium",
      "migrations_dir": "apps/server/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "novarium-books"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // 每小时清理一次导入失败留下的孤立文件。
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
