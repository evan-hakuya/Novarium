{
  "name": "@novarium/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev",
    "dev:node": "pnpm build && node dist/node.js",
    "build": "esbuild src/node.ts --bundle --platform=node --target=node24 --format=esm --external:better-sqlite3 --outfile=dist/node.js",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types",
    "deploy:cf": "wrangler deploy && wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@novarium/core": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "wrangler": "^4.166.0"
  }
}
