{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novarium",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "secrets": {
    "required": ["OWNER_PASSWORD"]
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novarium",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "novarium-books"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
