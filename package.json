{
  "name": "novarium",
  "private": true,
  "description": "Novarium 归藏：自托管的私人书库",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @novarium/web --filter @novarium/server dev",
    "build": "pnpm --filter @novarium/web build && pnpm --filter @novarium/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy": "pnpm --filter @novarium/server run deploy:cf",
    "deploy:cf": "pnpm --filter @novarium/web build && pnpm run deploy"
  },
  "cloudflare": {
    "bindings": {
      "OWNER_PASSWORD": {
        "description": "所有者密码，用来登录后台。建议用 `openssl rand -base64 24` 生成一个随机密码并保存好。"
      },
      "DB": {
        "description": "D1 数据库，保存书目、章节索引与访问令牌。"
      },
      "BOOKS": {
        "description": "R2 存储桶，保存原稿、整理后的正文与封面。"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
